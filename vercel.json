{
  "buildCommand": "npm run build && mkdir -p dist/chatmydrip && mv dist/index.html dist/chatmydrip/index.html || true",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/chatmydrip/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/chatmydrip/:path*",
      "destination": "/chatmydrip/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "https://easy-popup-049555.framer.app/$1"
    }
  ]
}
